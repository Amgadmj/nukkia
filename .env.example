# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (public — safe for the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-only — same values, read via process.env on the server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service role — SERVER ONLY, never expose to the client bundle ---
# Required for: server-side quota debits, admin tooling, the future cron/publish job.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Gemini API — https://aistudio.google.com/apikey) ---
# Required for every AI feature: diagnostic, plan, art/carousel, video storyboard + render.
GEMINI_API_KEY=

# Optional overrides — see src/lib/ai.server.ts for defaults and how each is used.
GEMINI_TEXT_MODEL_FAST=       # default: gemini-2.5-flash (plans, carousel outlines, storyboards, onboarding research)
GEMINI_TEXT_MODEL_QUALITY=    # default: gemini-2.5-pro (the diagnostic report)
GEMINI_IMAGE_MODEL=           # default: gemini-2.5-flash-image ("Nano Banana")
GEMINI_VIDEO_MODEL=           # default: veo-3.1-generate-preview — verify current availability
                               # at GET https://generativelanguage.googleapis.com/v1beta/models

# --- Cron / scheduled publishing ---
CRON_SECRET=
CRON_SECRET_PREVIOUS=
