# Normalize line endings: LF in the repository AND in every working tree,
# regardless of core.autocrlf. Prettier (via eslint-plugin-prettier) enforces
# "endOfLine": "lf", so CRLF checkouts on Windows otherwise fail lint on
# every line.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets: never normalize or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
