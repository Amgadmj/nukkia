# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (public — safe for the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-only — same values, read via process.env on the server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service role — SERVER ONLY, never expose to the client bundle ---
# Required for: server-side quota debits, admin tooling, the future cron/publish job.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: text/JSON generation (Anthropic Claude — https://console.anthropic.com) ---
# Required for: diagnostic report, content plan, carousel outline, video storyboard
# script, onboarding research draft. Everything text-shaped goes through Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=          # default: claude-sonnet-4-6 — see src/lib/ai.server.ts
ANTHROPIC_RESEARCH_MODEL=      # onboarding synthesis: claude-haiku-4-5-20251001 (separate from content generation)

# --- AI: image + video (Gemini API — https://aistudio.google.com/apikey) ---
# Required for: art/carousel images and video rendering. Not used for text anymore
# (see ANTHROPIC_API_KEY above) — Gemini's role here is Nano Banana + Veo only.
GEMINI_API_KEY=

# Optional overrides — see src/lib/ai.server.ts for defaults and how each is used.
GEMINI_IMAGE_MODEL=           # default: gemini-2.5-flash-image ("Nano Banana")
GEMINI_VIDEO_MODEL=           # default: veo-3.1-generate-preview — verify current availability
                               # at GET https://generativelanguage.googleapis.com/v1beta/models

# --- Cron / scheduled publishing ---
CRON_SECRET=
CRON_SECRET_PREVIOUS=
