# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (public — safe for the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-only — same values, read via process.env on the server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service role — SERVER ONLY, never expose to the client bundle ---
# Required for: server-side quota debits, admin tooling, the future cron/publish job.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# Lovable AI gateway key (text + static image generation today).
LOVABLE_API_KEY=

# Direct-provider fallback / self-hosted mode (see src/lib/ai.server.ts).
# When set, ai.server.ts talks to the provider directly instead of the Lovable gateway.
AI_PROVIDER=            # "lovable" (default) | "openai"
AI_API_KEY=
AI_BASE_URL=
AI_TEXT_MODEL=
AI_IMAGE_MODEL=

# --- Video generation provider (Content Engine) ---
# Optional. Until configured, video generation returns a storyboard only
# (status "awaiting_provider") instead of a rendered file. See docs/CONTENT_ENGINE.md.
VIDEO_PROVIDER=          # unset | "higgsfield"
VIDEO_PROVIDER_API_KEY=

# --- Cron / scheduled publishing ---
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
