# Copy to .env and fill in. Never commit the real .env file.

# --- Supabase (public — safe for the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Supabase (server-only — same values, read via process.env on the server) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# --- Supabase service role — SERVER ONLY, never expose to the client bundle ---
# Required for: server-side quota debits, admin tooling, the future cron/publish job.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI: text/JSON generation (Anthropic Claude — https://console.anthropic.com) ---
# Required for: diagnostic report, content plan, carousel outline, video storyboard
# script, onboarding research draft. Everything text-shaped goes through Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=          # default: claude-sonnet-4-6 — see src/lib/ai.server.ts
ANTHROPIC_RESEARCH_MODEL=      # onboarding synthesis: claude-haiku-4-5-20251001 (separate from content generation)
SCRAPLING_PYTHON=             # optional local absolute Python path; see scripts/scrapling/README.md
SCRAPLING_RENDER=             # 1 enables offline JS rendering of gateway-validated resources (requires Chrome)

# --- AI: image + video (Gemini API — https://aistudio.google.com/apikey) ---
# Required for: art/carousel images and video rendering. Not used for text anymore
# (see ANTHROPIC_API_KEY above) — Gemini's role here is Nano Banana + Veo only.
GEMINI_API_KEY=

# Optional overrides — see src/lib/ai.server.ts for defaults and how each is used.
GEMINI_IMAGE_MODEL=           # default: gemini-3.1-flash-image ("Nano Banana 2", GA). gemini-2.5-flash-image
                               # shuts down 2026-10-02 — do not pin it here.
GEMINI_VIDEO_MODEL=           # default: veo-3.1-generate-preview (no GA Veo id as of 2026-09-25) — verify availability
                               # at GET https://generativelanguage.googleapis.com/v1beta/models

# --- Video provider: Higgsfield (Seedance 2.0) — optional, off by default ---
# VIDEO_PROVIDER=higgsfield switches reels rendering from Veo to Higgsfield. Create the
# key pair in https://console.higgsfield.ai (server-side only, never in the browser bundle).
# Docs: https://docs.higgsfield.ai  -  failed and moderated requests are not charged.
VIDEO_PROVIDER=
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# draft = 480p (45 credits per 15 s), standard = 720p (67.5), premium = 1080p (135).
# Prices are CLI quotes from 2026-10-13; verify against the API estimate before launch.
HIGGSFIELD_VIDEO_PROFILE=      # default: standard
HIGGSFIELD_MAX_CREDITS_PER_RENDER=   # default: 70 — blocks premium until you raise it on purpose

# --- Billing: Asaas (Pix, card, boleto) ---
# API key from the Asaas panel (Integrações). ASAAS_ENV=sandbox until the first real charge.
# ASAAS_WEBHOOK_TOKEN is a 32+ character secret you also paste into the Asaas webhook
# (Integrações > Webhooks, URL https://<your-domain>/api/billing/webhook); Asaas sends it in the
# `asaas-access-token` header. Without it the webhook rejects every call.
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_WEBHOOK_TOKEN=

# --- Local promotional MP4 export (Node server only; no paid AI call) ---
# Needs ffmpeg with libx264. Resolution: FFMPEG_PATH, else `ffmpeg` on PATH, else the
# `ffmpeg-static` npm dependency (downloaded for the install machine's OS/arch by its
# install script; this is what runs on Vercel). Leave blank unless overriding.
FFMPEG_PATH=

# --- Cron / scheduled publishing ---
CRON_SECRET=
CRON_SECRET_PREVIOUS=
